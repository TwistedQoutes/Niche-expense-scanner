// Niche Expense Scanner — data model
//
// Postgres in every environment, including local development.
//
// The prototype used SQLite for zero-setup, but dev/prod parity matters more
// once real money and real tax records are involved: case sensitivity,
// transaction behaviour and type coercion all differ, and "it worked locally"
// is not something you want to discover from a customer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  studioName   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Bumped whenever every existing session must stop working — a password
  /// change or an explicit "sign out everywhere". The value is carried in the
  /// session token and compared on each request, which is what makes a
  /// self-contained JWT revocable without a session table.
  sessionVersion Int @default(0)

  emailVerifiedAt DateTime?

  // --- Billing ---------------------------------------------------------------
  // Mirrored from Stripe rather than owned here: Stripe is the source of truth
  // for what a customer has paid, and these columns exist so a page render does
  // not need a network call to find out.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// Stripe's own vocabulary: trialing, active, past_due, canceled, unpaid…
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  /// Free access until this moment, set at signup. Independent of Stripe, so a
  /// trial works before the artist has entered a card.
  trialEndsAt          DateTime?

  /// Opt-in receipt image retention, off by default.
  ///
  /// Keeping images is genuinely useful — the IRS wants documentary evidence
  /// for expenses over $75 — but it also means we become the custodian of
  /// photographs that can carry a client's name. So it is the artist's choice
  /// per account, not a deployment-wide decision, and the UI only claims
  /// images stay on the device when that is actually true for them.
  storeReceiptImages Boolean @default(false)

  expenses   Expense[]
  authTokens AuthToken[]

  @@map("users")
}

/// Every Stripe webhook we have already handled.
///
/// Stripe retries deliveries, and can deliver the same event more than once
/// even without a failure. Recording the event id and refusing to process a
/// repeat is what stops one payment being credited twice.
model WebhookEvent {
  /// Stripe's event id, which is the natural idempotency key.
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("webhook_events")
}

/// Single-use, short-lived token for password reset and email verification.
///
/// Only a SHA-256 hash of the token is stored. A leaked database therefore does
/// not hand over the ability to reset anyone's password — the same reason the
/// password itself is hashed.
model AuthToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token that was emailed. Unique, so a token cannot be shared.
  tokenHash String @unique
  /// "password_reset" or "email_verify".
  purpose   String

  expiresAt DateTime
  /// Set the moment it is redeemed, which is what makes it single-use.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Expense {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  merchant String
  // Money is stored as integer minor units (cents) to avoid float drift.
  amountCents Int
  taxCents    Int?
  currency    String @default("USD")

  // Calendar date the money was spent (receipt date), normalised to UTC midnight.
  spentAt DateTime

  // Categorisation lives on ExpenseLine, not here: a single supplier order can
  // span needles, ink and gloves, and forcing one category onto it either loses
  // that detail or files the whole receipt under the wrong Schedule C line.
  //
  // Deprecated, retained so existing rows can be backfilled without data loss
  // (see scripts/backfill-expense-lines.mjs). Drop once every deployment has
  // run the backfill.
  category           String?
  categoryConfidence Float?
  categorySource     String?

  notes    String?
  // Raw OCR text is retained so an expense can be re-parsed after parser
  // improvements without asking the user to re-scan the receipt.
  rawText  String?

  /// Storage key for the retained receipt image, or null when none is kept.
  /// Generated server-side — never derived from anything a client sends.
  imageKey      String?
  imageMimeType String?
  imageBytes    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every expense has at least one line. An unsplit receipt has exactly one
  /// covering its whole total; a split receipt has one per category. Keeping a
  /// single shape means there is one aggregation path rather than two that can
  /// disagree.
  lines ExpenseLine[]

  @@index([userId, spentAt])
  @@map("expenses")
}

/// One category's share of a receipt.
///
/// The sum of an expense's lines always equals `Expense.amountCents` exactly —
/// enforced in validation (src/lib/validation.ts) and by apportioning with the
/// largest-remainder method (src/lib/money.ts) so rounding can never lose or
/// invent a cent.
model ExpenseLine {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  /// What this share was for — "Cartridge needles 3RL", straight off the receipt.
  label       String?
  amountCents Int

  category           String
  categoryConfidence Float  @default(0)
  /// "auto" when the classifier chose it, "manual" once the artist overrides it.
  categorySource     String @default("auto")

  /// Stable display order, so editing one line does not reshuffle the rest.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseId])
  @@index([category])
  @@map("expense_lines")
}
