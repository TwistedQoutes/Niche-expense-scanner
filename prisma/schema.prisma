model File {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  jobId  String?
  job    Job?    @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)

  kind FileKind @default(OTHER)

  /// Storage key, generated server-side. Never derived from a client-supplied
  /// filename — that is how a path-traversal upload gets written outside its
  /// prefix.
  storageKey String
  /// Original name, for display only.
  fileName   String
  mimeType   String
  bytes      Int

  caption String?

  createdAt DateTime @default(now())

  @@index([organizationId, jobId])
  @@index([organizationId, leadId])
  @@map("files")
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Null means "everyone in the business" — a new lead, a quote accepted.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "lead.created" | "quote.accepted" | "job.completed" | "usage.limit_reached"
  type  String
  title String
  body  String?
  /// Where clicking it goes.
  href  String?

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId, userId, readAt])
  @@index([organizationId, createdAt])

  /*
   * Foreign keys, indexed.
   *
   * Postgres does not index a foreign key for you, and these columns are read in
   * two ways that both need one. Relations are traversed on read: the analytics
   * funnel asks "which leads have an accepted quote?", which Prisma compiles to a
   * correlated EXISTS over the (organizationId, leadId) pair — 224ms without this
   * index at 12k leads, 22ms with it. And every referential action does a lookup:
   * deleting a customer has to find the rows pointing at them before it can
   * cascade or clear the reference, which is a sequential scan on an unindexed key.
   */
  @@index([userId])
  @@map("notifications")
}

/// Who changed what. Written for anything that moves money, changes access, or
/// touches another person's data — the record you need when a customer asks
/// why their price changed.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Null for actions taken by the system or by an unauthenticated public page.
  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// "quote.accepted", "member.role_changed", "organization.suspended".
  action     String
  entityType String
  entityId   String?
  /// Before/after, or the request payload. Never credentials.
  metadata   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])

  /*
   * Foreign keys, indexed.
   *
   * Postgres does not index a foreign key for you, and these columns are read in
   * two ways that both need one. Relations are traversed on read: the analytics
   * funnel asks "which leads have an accepted quote?", which Prisma compiles to a
   * correlated EXISTS over the (organizationId, leadId) pair — 224ms without this
   * index at 12k leads, 22ms with it. And every referential action does a lookup:
   * deleting a customer has to find the rows pointing at them before it can
   * cascade or clear the reference, which is a sequential scan on an unindexed key.
   */
  @@index([actorUserId])
  @@map("audit_logs")
}
