// JobFlow AI — data model
//
// One Postgres database, many businesses. Every row that belongs to a customer
// of ours carries `organizationId`, and every query goes through the tenant
// client in src/lib/db/tenant.ts, which injects that filter rather than
// trusting each call site to remember it. The schema is built to make that
// enforceable: no tenant-owned model is reachable except through a column the
// extension knows how to constrain.
//
// Money is stored as integer minor units (cents). Floating-point currency is
// how a quote for $1,234.56 becomes $1,234.5599999 in a customer's inbox.
//
// ── Composite foreign keys, and the warning they produce ─────────────────────
//
// Filtering queries is not enough on its own. The tenant client rewrites the
// top-level `where` of the model being queried, but a foreign key is a plain
// cuid in a column, and nothing stopped one business's row from pointing at
// another's: create a lead in your own workspace naming someone else's
// `customerId`, then read it back, and Prisma's join follows the key and hands
// you their customer. A to-one `include` accepts no `where`, so that read cannot
// be filtered at all — there is nowhere to put the condition.
//
// So every relation between two tenant-owned models references
// `(organizationId, id)` instead of `id`, against an `@@unique` on the parent.
// A cross-tenant reference is then not a bug that has to be caught in
// application code; it is a row Postgres refuses to store.
//
// `prisma validate` and `prisma generate` will print a warning for each of these
// relations:
//
//     The `onDelete` referential action of a relation should not be set to
//     `SetNull` when a referenced field is required.
//
// That warning is expected, and its advice must NOT be followed here. It is
// right that plain `ON DELETE SET NULL` would break: nulling the whole pair
// would null `organizationId`, which is NOT NULL, and deleting a customer would
// fail outright. The migration therefore uses Postgres' column list —
// `ON DELETE SET NULL ("customerId")` — which clears only the reference and
// leaves the tenant column alone. Prisma cannot express that, but it also cannot
// see it: `migrate diff` reports no drift against a database built this way.
//
// The consequence to know about: if `prisma migrate dev` ever regenerates one of
// these constraints it will emit the plain form and quietly break deletes. A
// check in CI reads `pg_constraint.confdelsetcols` and fails if any of these
// constraints has lost its column list — see scripts/check-tenant-constraints.mjs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// Who someone is inside one business. Checked by `requireRole()` on every
/// route that changes money, billing or membership.
enum Role {
  OWNER
  ADMIN
  STAFF
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// The lead pipeline, in order. The Kanban board renders one column per value
/// and `position` orders cards inside a column.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTE_PENDING
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  PHONE_CALL
  MISSED_CALL
  SMS
  EMAIL
  REFERRAL
  GOOGLE
  FACEBOOK
  WALK_IN
  REPEAT_CUSTOMER
  MANUAL
  OTHER
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  CHANGES_REQUESTED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum JobStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Channel {
  SMS
  EMAIL
  CALL
  IN_APP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

/// What starts an automation. One enum rather than free text, because a typo in
/// a trigger name is an automation that silently never runs.
enum AutomationTrigger {
  LEAD_CREATED
  QUOTE_SENT
  QUOTE_VIEWED
  QUOTE_ACCEPTED
  QUOTE_DECLINED
  JOB_SCHEDULED
  JOB_COMPLETED
  CUSTOMER_INACTIVE
  MISSED_CALL
}

enum AutomationActionType {
  SEND_SMS
  SEND_EMAIL
  NOTIFY_OWNER
  CREATE_TASK
  REQUEST_REVIEW
  CHANGE_LEAD_STATUS
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReviewRequestStatus {
  PENDING
  SENT
  OPENED
  CLICKED
  COMPLETED
  FAILED
}

enum PlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

/// Which metered thing a Usage row counts. Plan limits are enforced against
/// these counters, so the set is closed on purpose.
enum UsageMetric {
  LEADS
  QUOTES
  SMS_SENT
  EMAILS_SENT
  AI_CALLS
}

enum PricingRuleKind {
  PER_UNIT_AREA
  PER_MILE
  FLAT_SURCHARGE
  PERCENT_SURCHARGE
  SEASONAL_MULTIPLIER
}

enum FileKind {
  LEAD_PHOTO
  JOB_BEFORE
  JOB_AFTER
  PROPERTY
  LOGO
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy, identity and access
// ─────────────────────────────────────────────────────────────────────────────

/// A business. The tenant boundary: every operational row below points here,
/// and a delete cascades the whole workspace.
model Organization {
  id   String @id @default(cuid())
  /// URL-safe handle, used for the public quote host and for support lookups.
  slug String @unique
  name String

  ownerName String?
  email     String?
  phone     String?
  website   String?
  /// Google Business / Yelp / Facebook page the review request links to.
  reviewUrl String?
  logoUrl   String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("US")
  latitude     Float?
  longitude    Float?

  /// "lawn_care", "pressure_washing", … Free text rather than an enum: the
  /// product is meant to grow into trades we have not thought of yet, and a
  /// migration should not be the price of selling to a new one.
  industry String @default("lawn_care")
  timezone String @default("America/New_York")
  currency String @default("USD")

  /// Service area, as a radius around the business address. A polygon model can
  /// replace this later without touching anything that reads `serviceRadiusMiles`.
  serviceRadiusMiles Int @default(25)

  // --- Pricing defaults, set during onboarding and editable in Settings ------
  // Every quote starts from these and can be overridden per service or per quote.
  defaultLaborRateCents  Int @default(3500)
  defaultProfitMarginBps Int @default(3000) /// 30.00% in basis points
  defaultTravelFeeCents  Int @default(1000)
  defaultMinimumJobCents Int @default(4500)
  defaultOverheadCents   Int @default(0)
  /// Sales tax applied to quotes, in basis points. 0 for services that are not taxed.
  defaultTaxRateBps      Int @default(0)

  status      OrganizationStatus @default(ACTIVE)
  onboardedAt DateTime?
  /// Marks the seeded sample workspace so the demo can be reset and so it can be
  /// excluded from admin revenue figures.
  isDemo      Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  subscription   Subscription?
  customers      Customer[]
  leads          Lead[]
  leadActivities LeadActivity[]
  services       Service[]
  pricingRules   PricingRule[]
  properties     Property[]
  quotes         Quote[]
  quoteItems     QuoteItem[]
  jobs           Job[]
  appointments   Appointment[]
  conversations  Conversation[]
  messages       Message[]
  automations    Automation[]
  automationRuns AutomationRun[]
  reviewRequests ReviewRequest[]
  files          File[]
  notifications  Notification[]
  usage          Usage[]
  invoices       Invoice[]
  auditLogs      AuditLog[]
  invitations    Invitation[]

  @@index([status])
  @@index([createdAt])
  @@map("organizations")
}

/// A person. Deliberately *not* org-scoped: one operator can run two businesses
/// and should not need two passwords. Their access comes from Membership.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?
  phone        String?
  avatarUrl    String?

  /// Bumped whenever every existing session must stop working — a password
  /// change or an explicit "sign out everywhere". The value rides in the session
  /// token and is compared on each request, which is what makes a self-contained
  /// JWT revocable without a session table.
  sessionVersion Int @default(0)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  /// Staff of the SaaS, not of a customer. Gates /admin.
  isPlatformAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  authTokens    AuthToken[]
  assignedJobs  Job[]          @relation("JobAssignee")
  notifications Notification[]
  auditLogs     AuditLog[]
  sentInvites   Invitation[]   @relation("InvitedBy")

  @@index([createdAt])
  @@map("users")
}

/// Which businesses a user can act in, and as what.
model Membership {
  id             String @id @default(cuid())
  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role   Role             @default(STAFF)
  status MembershipStatus @default(ACTIVE)

  /// Set when an owner invites a teammate who has not accepted yet.
  invitedAt  DateTime?
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One membership per person per business — the constraint that makes
  /// "which role am I here?" a single unambiguous answer.
  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("memberships")
}

/// Single-use, short-lived token for password reset and email verification.
///
/// Only a SHA-256 hash is stored, so a leaked database does not hand over the
/// ability to reset anyone's password.
/// An invitation to join a business, addressed to an email rather than a user.
///
/// Deliberately not an `AuthToken`. Those hang off a `userId`, and the whole
/// point of an invitation is that the person may not exist yet — `User` requires
/// a `passwordHash`, so issuing one through AuthToken would mean creating a
/// half-built account that cannot log in and must be cleaned up if the invite is
/// never accepted. Addressing the email directly means an unaccepted invitation
/// is one row with nothing else attached to it.
///
/// The token discipline is copied from `src/lib/auth/tokens.ts` on purpose: 256
/// bits of randomness, only ever stored as a SHA-256 hash, single-use through a
/// conditional update rather than read-then-write, and an expiry — so an old
/// invitation sitting in an inbox stops being a key to someone's customer list.
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Lower-cased at validation, because "Sam@" and "sam@" are one person and an
  /// invitation that can be issued twice is a seat counted twice.
  email String
  role  Role   @default(STAFF)

  /// SHA-256 of the token that was emailed. The plaintext exists once, in transit.
  tokenHash String @unique

  expiresAt  DateTime
  acceptedAt DateTime?
  /// Set when an owner withdraws an invitation, and when a newer invitation to
  /// the same address supersedes this one. Either way it can no longer be used.
  revokedAt  DateTime?

  /// Who sent it. Nullable because a departed owner should not take the audit
  /// trail of who let someone in with them.
  invitedByUserId String?
  invitedBy       User?   @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The pending list on the team screen, newest first.
  @@index([organizationId, acceptedAt, createdAt])
  /// Finding an outstanding invitation for one address, to supersede it.
  @@index([organizationId, email])
  /// Foreign key, indexed — see the note on the other models.
  @@index([invitedByUserId])
  @@index([expiresAt])
  @@map("invitations")
}

model AuthToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  /// "password_reset" | "email_verify" | "team_invite".
  purpose   String

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────────────────────────────────────

/// Mirrored from Stripe rather than owned here. Stripe is the source of truth
/// for what a business has paid; these columns exist so rendering a page does
/// not need a network call to find out whether to show a paywall.
model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan   PlanTier           @default(FREE)
  status SubscriptionStatus @default(TRIALING)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  /// Free access until this moment, independent of Stripe so a trial works
  /// before a card is ever entered.
  trialEndsAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plan])
  @@map("subscriptions")
}

/// Every Stripe webhook already handled. Stripe retries deliveries and can send
/// the same event twice without a failure; recording the id and refusing a
/// repeat is what stops one payment being credited twice.
model WebhookEvent {
  /// Stripe's event id — the natural idempotency key.
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("webhook_events")
}

/// A Stripe invoice, mirrored for the billing history table.
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stripeInvoiceId  String  @unique
  number           String?
  amountDueCents   Int
  amountPaidCents  Int     @default(0)
  currency         String  @default("USD")
  /// Stripe's own vocabulary: draft, open, paid, void, uncollectible.
  status           String
  hostedInvoiceUrl String?
  pdfUrl           String?

  periodStart DateTime?
  periodEnd   DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("invoices")
}

/// A metered counter for one organization, one metric, one calendar month.
///
/// Plan limits are checked against this rather than by counting rows: a FREE
/// plan allows 5 leads *per month*, and `SELECT count(*) FROM leads` answers a
/// different question once a lead is deleted.
model Usage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  metric UsageMetric
  /// First instant of the UTC month this counter covers.
  period DateTime
  count  Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One counter per org/metric/month, so increments can be a single
  /// atomic upsert instead of a read-modify-write race.
  @@unique([organizationId, metric, period])
  @@index([organizationId, period])
  @@map("usage")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM: customers, leads, properties
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  email     String?
  phone     String?
  company   String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("US")

  notes String?
  tags  String[] @default([])

  /// Denormalised rollups. Recomputed when a job completes rather than summed
  /// on every render — the customer list is a hot path and a per-row aggregate
  /// over jobs turns it into N queries.
  lifetimeValueCents Int       @default(0)
  jobsCompleted      Int       @default(0)
  lastServicedAt     DateTime?
  /// Drives the reactivation automation: "ready for your next lawn service?"
  nextServiceDueAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads          Lead[]
  properties     Property[]
  quotes         Quote[]
  jobs           Job[]
  appointments   Appointment[]
  conversations  Conversation[]
  reviewRequests ReviewRequest[]

  @@index([organizationId, createdAt])
  @@index([organizationId, lastName])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, nextServiceDueAt])
  /// The target of a composite foreign key. Children reference
  /// (organizationId, id) rather than id alone, so Postgres itself refuses a row
  /// that points at another business's record — see the note at the top of this
  /// file. Prisma requires the referenced pair to be unique.
  @@unique([organizationId, id])

  @@map("customers")
}

/// A property a service is performed at. Separate from Customer because one
/// customer can own several (a house and a rental), and the measurements that
/// drive pricing belong to the land, not the person.
model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: SetNull)

  label        String?
  addressLine1 String
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("US")

  latitude      Float?
  longitude     Float?
  /// Google's stable id for the address, so a re-geocode returns the same place.
  googlePlaceId String?

  /// Measured area in square feet, and where the number came from.
  ///
  /// `measurementSource` is load-bearing rather than metadata: satellite
  /// imagery does not yield an exact lawn area, and a quote built on a guess
  /// that is *presented* as a measurement is how a business loses money on a
  /// job. The UI labels anything that is not MANUAL as an estimate.
  lotSizeSqFt       Int?
  lawnAreaSqFt      Int?
  /// "manual" | "estimated" | "parcel_api" | "unknown"
  measurementSource String  @default("unknown")
  measurementNotes  String?

  accessNotes String?
  gateCode    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads  Lead[]
  quotes Quote[]
  jobs   Job[]

  @@index([organizationId, customerId])
  @@index([organizationId, postalCode])
  /// The target of a composite foreign key. Children reference
  /// (organizationId, id) rather than id alone, so Postgres itself refuses a row
  /// that points at another business's record — see the note at the top of this
  /// file. Prisma requires the referenced pair to be unique.
  @@unique([organizationId, id])

  @@map("properties")
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Set once a lead is converted; null while it is still just an enquiry.
  customerId String?
  customer   Customer? @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: SetNull)
  propertyId String?
  property   Property? @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: SetNull)

  firstName String
  lastName  String?
  email     String?
  phone     String?

  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?

  source           LeadSource @default(MANUAL)
  serviceRequested String?
  description      String?

  status   LeadStatus @default(NEW)
  /// Ordering inside a Kanban column. Fractional gaps (1024, 2048, …) let a
  /// card be dropped between two others by averaging its neighbours, so a drag
  /// writes one row instead of renumbering the column.
  position Int        @default(0)

  estimatedValueCents Int?

  // --- AI qualification, written by POST /api/ai/qualify --------------------
  // Null until the model has run. Kept as columns rather than a JSON blob so
  // the pipeline can sort and filter by score without parsing every row.
  aiScore             Int?
  aiSummary           String?
  aiIntent            String?
  aiUrgency           Urgency?
  aiRecommendedAction String?
  aiSuggestedResponse String?
  aiQualifiedAt       DateTime?
  /// Which model produced the fields above, so a scoring change is traceable.
  aiModel             String?

  notes           String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  /// Why a lead was lost. Feeds the analytics breakdown.
  lostReason      String?
  closedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities    LeadActivity[]
  quotes        Quote[]
  conversations Conversation[]
  files         File[]

  @@index([organizationId, status, position])
  @@index([organizationId, createdAt])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, aiScore])

  /*
   * Foreign keys, indexed.
   *
   * Postgres does not index a foreign key for you, and these columns are read in
   * two ways that both need one. Relations are traversed on read: the analytics
   * funnel asks "which leads have an accepted quote?", which Prisma compiles to a
   * correlated EXISTS over the (organizationId, leadId) pair — 224ms without this
   * index at 12k leads, 22ms with it. And every referential action does a lookup:
   * deleting a customer has to find the rows pointing at them before it can
   * cascade or clear the reference, which is a sequential scan on an unindexed key.
   */
  @@index([organizationId, customerId])
  @@index([organizationId, propertyId])
  /// The target of a composite foreign key. Children reference
  /// (organizationId, id) rather than id alone, so Postgres itself refuses a row
  /// that points at another business's record — see the note at the top of this
  /// file. Prisma requires the referenced pair to be unique.
  @@unique([organizationId, id])

  @@map("leads")
}

/// An append-only trail of what happened to a lead. Written by humans and by
/// automations alike, so the timeline on a lead page tells the whole story.
model LeadActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)

  /// "status_changed" | "note" | "ai_qualified" | "quote_sent" | "message_sent" …
  type    String
  summary String
  /// Structured detail for the type — old/new status, quote id, model output.
  detail  Json?

  /// Null when an automation or the AI did it rather than a person.
  actorUserId String?

  createdAt DateTime @default(now())

  @@index([organizationId, leadId, createdAt])
  @@map("lead_activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalogue and pricing
// ─────────────────────────────────────────────────────────────────────────────

/// A reusable service with its own pricing defaults — "Lawn Mowing, $45 base,
/// $10 per extra 1,000 sq ft, 30 minutes of labour".
model Service {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// Stable key for seeded templates ("lawn_mowing"); null for custom services.
  templateKey String?

  basePriceCents    Int @default(0)
  minimumPriceCents Int @default(0)
  /// Area-priced services: an extra `unitPriceCents` per `unitSizeSqFt`.
  unitPriceCents    Int @default(0)
  unitSizeSqFt      Int @default(1000)

  /// Labour estimate, in minutes, for the base job.
  estimatedMinutes   Int  @default(30)
  /// Overrides the organization default when set.
  laborRateCents     Int?
  materialCostCents  Int  @default(0)
  equipmentCostCents Int  @default(0)

  taxable  Boolean @default(false)
  active   Boolean @default(true)
  /// Display order in the service picker.
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingRules PricingRule[]
  quoteItems   QuoteItem[]
  jobs         Job[]
  appointments Appointment[]

  @@unique([organizationId, name])
  @@index([organizationId, active, position])
  /// The target of a composite foreign key. Children reference
  /// (organizationId, id) rather than id alone, so Postgres itself refuses a row
  /// that points at another business's record — see the note at the top of this
  /// file. Prisma requires the referenced pair to be unique.
  @@unique([organizationId, id])

  @@map("services")
}

/// A modifier applied on top of a service's base price during calculation.
///
/// Kept as data rather than code so a business can express "add 15% for slopes
/// over half an acre" without a deploy. `kind` decides how `amount` is read.
model PricingRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service? @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Cascade)

  name String
  kind PricingRuleKind

  /// Cents for the *_CENTS kinds, basis points for the percentage kinds.
  amount Int

  /// Applies only when the driving quantity falls in [minValue, maxValue].
  /// Square feet for area rules, miles for travel rules.
  minValue Int?
  maxValue Int?

  active   Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, serviceId, active])
  @@map("pricing_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// Quotes
// ─────────────────────────────────────────────────────────────────────────────

model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Human-facing sequence, unique per business: Q-1001, Q-1002.
  number String

  customerId String?
  customer   Customer? @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: SetNull)
  leadId     String?
  lead       Lead?     @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: SetNull)
  propertyId String?
  property   Property? @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: SetNull)

  /// The unguessable half of the public URL, /quote/{publicId}. A customer must
  /// be able to open a quote without an account, so the id *is* the credential:
  /// it is random, not sequential, and carries no tenant information.
  publicId String @unique

  status  QuoteStatus @default(DRAFT)
  title   String?
  /// What the customer reads. Written by the owner or drafted by the AI.
  summary String?
  terms   String?

  // --- The calculation, stored rather than recomputed -----------------------
  // A sent quote is a commercial document: it must show the same numbers next
  // year that it showed the day it was sent, even if labour rates have changed
  // since. So the inputs *and* the outputs are frozen onto the row.
  laborMinutes       Int @default(0)
  laborRateCents     Int @default(0)
  laborCostCents     Int @default(0)
  materialCostCents  Int @default(0)
  equipmentCostCents Int @default(0)
  travelMiles        Int @default(0)
  travelCostCents    Int @default(0)
  overheadCents      Int @default(0)
  /// Sum of the cost components above — what the job costs to perform.
  estimatedCostCents Int @default(0)

  /// Target margin used to derive the price, in basis points.
  profitMarginBps Int     @default(0)
  subtotalCents   Int     @default(0)
  discountCents   Int     @default(0)
  taxRateBps      Int     @default(0)
  taxCents        Int     @default(0)
  /// What the customer pays. The single number the accept button commits to.
  totalCents      Int     @default(0)
  /// Set when the owner types over the calculated price, so analytics can tell
  /// a deliberate discount from a pricing-model problem.
  priceOverridden Boolean @default(false)
  currency        String  @default("USD")

  expiresAt     DateTime?
  sentAt        DateTime?
  firstViewedAt DateTime?
  viewCount     Int       @default(0)
  respondedAt   DateTime?
  /// What the customer typed into "Request changes".
  customerNote  String?

  /// How many follow-ups have gone out, so the automation knows where it is.
  followUpCount  Int       @default(0)
  lastFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteItem[]
  jobs  Job[]

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, expiresAt])
  @@index([organizationId, customerId])

  /*
   * Foreign keys, indexed.
   *
   * Postgres does not index a foreign key for you, and these columns are read in
   * two ways that both need one. Relations are traversed on read: the analytics
   * funnel asks "which leads have an accepted quote?", which Prisma compiles to a
   * correlated EXISTS over the (organizationId, leadId) pair — 224ms without this
   * index at 12k leads, 22ms with it. And every referential action does a lookup:
   * deleting a customer has to find the rows pointing at them before it can
   * cascade or clear the reference, which is a sequential scan on an unindexed key.
   */
  @@index([organizationId, leadId])
  @@index([organizationId, propertyId])
  /// The target of a composite foreign key. Children reference
  /// (organizationId, id) rather than id alone, so Postgres itself refuses a row
  /// that points at another business's record — see the note at the top of this
  /// file. Prisma requires the referenced pair to be unique.
  @@unique([organizationId, id])

  @@map("quotes")
}

/// One line on a quote. The sum of the lines is the quote subtotal — enforced
/// in the calculator so the document a customer sees always adds up.
model QuoteItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  quoteId String
  quote   Quote  @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Cascade)

  serviceId String?
  service   Service? @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: SetNull)

  /// Copied from the service rather than joined, so editing the catalogue does
  /// not silently rewrite quotes that were already sent.
  name        String
  description String?

  /// Thousandths of a unit, so "1.5 hours" needs no float.
  quantityMilli  Int @default(1000)
  unitPriceCents Int @default(0)
  totalCents     Int @default(0)

  taxable  Boolean @default(false)
  /// An add-on the customer can decline without rejecting the whole quote.
  optional Boolean @default(false)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, quoteId, position])

  /*
   * Foreign keys, indexed.
   *
   * Postgres does not index a foreign key for you, and these columns are read in
   * two ways that both need one. Relations are traversed on read: the analytics
   * funnel asks "which leads have an accepted quote?", which Prisma compiles to a
   * correlated EXISTS over the (organizationId, leadId) pair — 224ms without this
   * index at 12k leads, 22ms with it. And every referential action does a lookup:
   * deleting a customer has to find the rows pointing at them before it can
   * cascade or clear the reference, which is a sequential scan on an unindexed key.
   */
  @@index([organizationId, serviceId])
  @@map("quote_items")
}

