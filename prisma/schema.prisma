  propertyId String?
  property   Property? @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: SetNull)
  quoteId    String?
  quote      Quote?    @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: SetNull)
  serviceId  String?
  service    Service?  @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: SetNull)

  assignedUserId String?
  assignedUser   User?   @relation("JobAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  status      JobStatus @default(SCHEDULED)
  title       String
  description String?

  /// Agreed price, copied from the accepted quote and then independent of it.
  priceCents Int    @default(0)
  currency   String @default("USD")

  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  completionNotes String?
  cancelledAt     DateTime?
  cancelReason    String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  files          File[]
  reviewRequests ReviewRequest[]

  @@unique([organizationId, number])
  @@index([organizationId, status, scheduledFor])
  @@index([organizationId, customerId])
  @@index([organizationId, assignedUserId])

  /*
   * Foreign keys, indexed.
   *
   * Postgres does not index a foreign key for you, and these columns are read in
   * two ways that both need one. Relations are traversed on read: the analytics
   * funnel asks "which leads have an accepted quote?", which Prisma compiles to a
   * correlated EXISTS over the (organizationId, leadId) pair — 224ms without this
   * index at 12k leads, 22ms with it. And every referential action does a lookup:
   * deleting a customer has to find the rows pointing at them before it can
   * cascade or clear the reference, which is a sequential scan on an unindexed key.
   */
  @@index([organizationId, quoteId])
  @@index([organizationId, propertyId])
  @@index([organizationId, serviceId])
  @@index([assignedUserId])
  /// The target of a composite foreign key. Children reference
  /// (organizationId, id) rather than id alone, so Postgres itself refuses a row
  /// that points at another business's record — see the note at the top of this
  /// file. Prisma requires the referenced pair to be unique.
  @@unique([organizationId, id])

  @@map("jobs")
}

model Appointment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: SetNull)
  jobId      String?
  job        Job?      @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)
  serviceId  String?
  service    Service?  @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: SetNull)

  title  String
  status AppointmentStatus @default(SCHEDULED)

  /// Half-open [startsAt, endsAt). Stored as instants, displayed in the
  /// organization's timezone — a crew's 9am is a wall-clock time, and storing it
  /// as one would break the first time the calendar crossed a DST boundary.
  startsAt DateTime
  endsAt   DateTime
  allDay   Boolean  @default(false)

  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?

  /// Denormalised so the calendar can show revenue per slot in one query.
  estimatedRevenueCents Int @default(0)

  notes String?

  /// Reserved for the Google Calendar sync: the remote event id, so a two-way
  /// sync can match rows instead of creating duplicates.
  externalCalendarId String?
  externalEventId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startsAt])
  @@index([organizationId, status, startsAt])
  @@index([organizationId, jobId])

  /*
   * Foreign keys, indexed.
   *
   * Postgres does not index a foreign key for you, and these columns are read in
   * two ways that both need one. Relations are traversed on read: the analytics
   * funnel asks "which leads have an accepted quote?", which Prisma compiles to a
   * correlated EXISTS over the (organizationId, leadId) pair — 224ms without this
   * index at 12k leads, 22ms with it. And every referential action does a lookup:
   * deleting a customer has to find the rows pointing at them before it can
   * cascade or clear the reference, which is a sequential scan on an unindexed key.
   */
  @@index([organizationId, customerId])
  @@index([organizationId, serviceId])
  @@map("appointments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Communication
// ─────────────────────────────────────────────────────────────────────────────

/// A thread with one person on one channel. The unified inbox lists these; the
/// messages hang off them.
model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: SetNull)
  leadId     String?
  lead       Lead?     @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: SetNull)

  channel Channel
  /// The phone number or email address on the other end. Together with the
  /// channel this is what an inbound webhook matches on to find the thread.
  contact String
  subject String?

  lastMessageAt DateTime?
  unreadCount   Int       @default(0)
  /// An owner closes a thread to get it out of the inbox without deleting it.
  archived      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([organizationId, channel, contact])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, archived, lastMessageAt])

  /*
   * Foreign keys, indexed.
   *
   * Postgres does not index a foreign key for you, and these columns are read in
   * two ways that both need one. Relations are traversed on read: the analytics
   * funnel asks "which leads have an accepted quote?", which Prisma compiles to a
   * correlated EXISTS over the (organizationId, leadId) pair — 224ms without this
   * index at 12k leads, 22ms with it. And every referential action does a lookup:
   * deleting a customer has to find the rows pointing at them before it can
   * cascade or clear the reference, which is a sequential scan on an unindexed key.
   */
  @@index([organizationId, customerId])
  @@index([organizationId, leadId])
  /// The target of a composite foreign key. Children reference
  /// (organizationId, id) rather than id alone, so Postgres itself refuses a row
  /// that points at another business's record — see the note at the top of this
  /// file. Prisma requires the referenced pair to be unique.
  @@unique([organizationId, id])

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)

  channel   Channel
  direction MessageDirection
  status    MessageStatus    @default(QUEUED)

  /// Denormalised endpoints, so a message renders correctly even if the
  /// customer later changes their number.
  fromAddress String?
  toAddress   String?

  subject String?
  body    String

  /// True when the AI assistant composed it rather than a person.
  aiGenerated       Boolean @default(false)
  /// Twilio's SID or Resend's message id, for delivery-status callbacks.
  providerMessageId String?
  errorMessage      String?

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@index([providerMessageId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Automations
// ─────────────────────────────────────────────────────────────────────────────

/// A trigger plus an ordered list of steps. The shape is deliberately linear
/// for the MVP; a branching visual builder can add a `parentStepId` to
/// AutomationStep later without changing how existing rows execute.
model Automation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  trigger     AutomationTrigger
  enabled     Boolean           @default(true)

  /// Seeded defaults ("quote_follow_up") are matched by key so an upgrade can
  /// improve them without duplicating a business's customised copy.
  templateKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps AutomationStep[]
  runs  AutomationRun[]

  @@index([organizationId, trigger, enabled])
  /// The target of a composite foreign key. Children reference
  /// (organizationId, id) rather than id alone, so Postgres itself refuses a row
  /// that points at another business's record — see the note at the top of this
  /// file. Prisma requires the referenced pair to be unique.
  @@unique([organizationId, id])

  @@map("automations")
}

model AutomationStep {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  position     Int
  /// Delay after the previous step before this one fires. 0 means immediately.
  delayMinutes Int @default(0)

  action AutomationActionType

  /// Message body, with {{first_name}}-style placeholders filled at send time.
  template String?
  subject  String?
  /// Action-specific settings — the target status for CHANGE_LEAD_STATUS, and
  /// whether to let the AI personalise `template` before sending.
  config   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([automationId, position])
  @@map("automation_steps")
}

/// One in-flight or finished execution of an automation against one record.
///
/// This is the scheduler's queue: a worker claims rows whose `runAt` has passed.
/// Keeping the position in `currentStep` means a run survives a restart.
model AutomationRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  automationId String
  automation   Automation @relation(fields: [organizationId, automationId], references: [organizationId, id], onDelete: Cascade)

  /// What the run is about: "lead" | "quote" | "job" | "customer", plus its id.
  /// A polymorphic pair rather than six nullable foreign keys.
  subjectType String
  subjectId   String

  status      AutomationRunStatus @default(PENDING)
  currentStep Int                 @default(0)
  /// When the next step is due. The index on (status, runAt) is the queue scan.
  runAt       DateTime
  startedAt   DateTime?
  completedAt DateTime?
  lastError   String?
  attempts    Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live run per automation per subject: re-triggering while a follow-up
  /// sequence is already in flight must not start a second one.
  @@unique([automationId, subjectType, subjectId])
  @@index([status, runAt])
  @@index([organizationId, status])

  /*
   * Foreign keys, indexed.
   *
   * Postgres does not index a foreign key for you, and these columns are read in
   * two ways that both need one. Relations are traversed on read: the analytics
   * funnel asks "which leads have an accepted quote?", which Prisma compiles to a
   * correlated EXISTS over the (organizationId, leadId) pair — 224ms without this
   * index at 12k leads, 22ms with it. And every referential action does a lookup:
   * deleting a customer has to find the rows pointing at them before it can
   * cascade or clear the reference, which is a sequential scan on an unindexed key.
   */
  @@index([organizationId, automationId])
  @@map("automation_runs")
}

/// A review ask, tracked through open and click so the owner can see which
/// customers actually left one.
model ReviewRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Cascade)
  jobId      String?
  job        Job?     @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: SetNull)

  channel Channel             @default(SMS)
  status  ReviewRequestStatus @default(PENDING)

  /// Random token behind the tracked redirect, /r/{token} → the review URL.
  token     String  @unique
  reviewUrl String?

  sentAt    DateTime?
  openedAt  DateTime?
  clickedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])

  /*
   * Foreign keys, indexed.
   *
   * Postgres does not index a foreign key for you, and these columns are read in
   * two ways that both need one. Relations are traversed on read: the analytics
   * funnel asks "which leads have an accepted quote?", which Prisma compiles to a
   * correlated EXISTS over the (organizationId, leadId) pair — 224ms without this
   * index at 12k leads, 22ms with it. And every referential action does a lookup:
   * deleting a customer has to find the rows pointing at them before it can
   * cascade or clear the reference, which is a sequential scan on an unindexed key.
   */
  @@index([organizationId, jobId])
  @@map("review_requests")
}

