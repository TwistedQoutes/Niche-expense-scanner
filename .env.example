# ---------------------------------------------------------------------------
# Niche Expense Scanner — environment
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

# Database connection string.
# Prototype default (SQLite, zero setup):
DATABASE_URL="file:./prisma/dev.db"
# Production (Postgres) — also switch `provider` in prisma/schema.prisma to
# "postgresql" and swap the driver adapter in src/lib/db.ts:
# DATABASE_URL="postgresql://user:password@host:5432/niche_expense_scanner?sslmode=require"

# Secret used to sign session JWTs. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Session lifetime in seconds (default: 7 days).
SESSION_MAX_AGE="604800"

# Where receipt images are stored: "none" keeps images in the browser only
# (default, most private), "local" writes them under ./storage.
RECEIPT_STORAGE_DRIVER="none"

# Public origin, used for absolute URLs and cookie scoping in production.
# NEXT_PUBLIC_APP_URL="https://scanner.example.com"
