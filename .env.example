# ---------------------------------------------------------------------------
# Niche Expense Scanner — environment
#
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.
# Anything without a default below is REQUIRED — the app validates its whole
# environment at boot and refuses to start rather than failing later.
#
# For a step-by-step production setup, see DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------

# Postgres connection string. Use a POOLED connection in production (Neon's
# "-pooler" host, Supabase port 6543, or pgBouncer): serverless runs many short
# instances and a direct connection limit is exhausted quickly.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/nes_dev"

# Signs session cookies. At least 32 characters.
#   openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Public origin. Used for links inside emails and for Stripe redirects, so it
# must be the real URL in production — these run where there is no request to
# infer it from.
APP_URL="http://localhost:3000"

# --- Optional: connection pool ---------------------------------------------
# DATABASE_POOL_MAX="3"

# --- Session ---------------------------------------------------------------
# SESSION_MAX_AGE="604800"   # seconds; default 7 days

# --- Email -----------------------------------------------------------------
# "none" prints emails to the server console instead of sending them, which is
# right for local development. Password reset does not work for real until this
# is switched to "resend" — so set it before charging anyone.
EMAIL_DRIVER="none"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Niche Expense Scanner <hello@yourdomain.com>"

# --- Billing ---------------------------------------------------------------
# Leave every STRIPE_* value unset to run the app free and unmetered — useful
# for self-hosting, and the state the app is in before you finish Stripe setup.
# Setting STRIPE_SECRET_KEY requires the other two as well.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ID="price_..."

# Days of full access before payment is required.
TRIAL_DAYS="14"
# Shown on the subscribe button. Keep it in step with the Stripe price.
PRICE_LABEL="$7/month"

# --- Receipt images --------------------------------------------------------
# "none" (default) never uploads images; "local" writes them under ./storage,
# which only works on a host with a persistent disk — NOT on Vercel or similar.
# Each artist must still opt in individually.
RECEIPT_STORAGE_DRIVER="none"

# --- Contact ---------------------------------------------------------------
# Appears in the terms and privacy policy. Use an address you actually read.
SUPPORT_EMAIL="support@example.com"
