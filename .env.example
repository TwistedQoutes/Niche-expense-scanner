# JobFlow AI — environment
#
# Copy to .env and fill in. Never commit .env; never put a real key in this file.
#
# Only the first two sections are required to run the app. Every integration
# below them is optional and independently switchable: JobFlow has to be useful
# to an operator who has signed up for nothing but a database, so leads, quotes,
# the pipeline and the CRM all work with OpenAI, Stripe, Twilio, Resend and
# Google Maps unset. Each one turns on a feature; none of them gates the core.

# ── Required: database ───────────────────────────────────────────────────────
# Postgres in every environment, including local development. Point this at a
# POOLED endpoint in production (pgBouncer, Neon `-pooler`, Supabase port 6543):
# serverless runs many short-lived instances and an unpooled URL exhausts the
# connection limit long before the app is actually busy.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobflow"

# Direct, unpooled connection. Prisma Migrate needs one — a pooler cannot run
# the advisory locks and DDL a migration requires. Same database, port 5432.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jobflow"

# Connections per instance. Small on purpose; raise only on a long-lived server
# with a connection limit to spare.
DATABASE_POOL_MAX="3"

# ── Required: sessions ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Rotating this signs everyone out, which is the intended way to revoke every
# session at once after a compromise.
AUTH_SECRET=""

# Seconds. Seven days by default.
SESSION_MAX_AGE="604800"

# Public origin. Quote links, review links and password-reset links are absolute
# URLs sent by email and SMS, and a background job has no request to infer a
# host from. Set this to your real domain in production.
APP_URL="http://localhost:3000"

SUPPORT_EMAIL="support@jobflow.ai"

# ── Optional: email (Resend) ─────────────────────────────────────────────────
# "none" prints messages to the server console instead of sending them, which is
# right for local development and loud enough in production logs to get noticed.
EMAIL_DRIVER="none"
RESEND_API_KEY=""
# Must be a domain you have verified with Resend, or delivery will fail.
EMAIL_FROM="JobFlow AI <onboarding@resend.dev>"

# ── Optional: SMS (Twilio) ───────────────────────────────────────────────────
# Powers quote follow-ups, the missed-call text back and the unified inbox.
SMS_DRIVER="none"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# E.164, e.g. +15551234567. Must be SMS-capable and, in the US, 10DLC-registered.
TWILIO_PHONE_NUMBER=""
# Only set these if you are behind a proxy or using a regional Twilio edge.
TWILIO_BASE_URL="https://api.twilio.com/2010-04-01"
# The exact public URL Twilio is configured to POST to. Twilio signs that URL,
# so behind a tunnel or proxy the request's own host differs from it and every
# legitimate webhook would fail verification. Defaults to APP_URL + the path.
TWILIO_WEBHOOK_URL=""

# ── Optional: AI (OpenAI) ────────────────────────────────────────────────────
# Lead scoring, message drafting and the customer assistant.
AI_DRIVER="none"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Point this at Azure OpenAI, an egress proxy, or a self-hosted gateway if you
# use one. Anything that speaks the chat-completions API will do.
OPENAI_BASE_URL="https://api.openai.com/v1"

# ── Not built yet: Google Maps ───────────────────────────────────────────────
# NOTHING READS THESE. Address autocomplete and drive-time estimates are planned
# and not implemented, so setting them turns nothing on. They are kept here so the
# two-key split is settled before the feature lands: they need different
# restrictions and must not be the same string — the browser key is visible in
# page source and should be locked to your domain (HTTP referrer) with only the
# Maps JavaScript API enabled; the server key would be used for Geocoding, must
# never reach the browser, and should be restricted by IP.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ── Optional: billing (Stripe) ───────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY unset to run without billing; every plan limit still
# applies, based on the subscription row in the database.
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Required whenever STRIPE_SECRET_KEY is set — an unverified webhook
# is an endpoint anyone can use to grant themselves a subscription.
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Only set this if you are behind a proxy or pointing at a Stripe emulator.
STRIPE_BASE_URL="https://api.stripe.com/v1"

# Recurring price ids (price_..., not prod_...) for each paid tier.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# ── Optional: demo mode ──────────────────────────────────────────────────────
# "on" lets any visitor spin up a seeded, throwaway workspace with no account.
# It is an unauthenticated route that writes to the real database, so it is off
# unless you ask for it. A demo workspace can never send a text or an email, can
# never be subscribed to, and is deleted by the daily sweep.
DEMO_MODE="off"
# How long a demo workspace lives, in hours.
DEMO_TTL_HOURS="24"

# Days of full Pro access before a card is required. 0 disables the trial.
TRIAL_DAYS="14"

# ── Optional: automation worker ──────────────────────────────────────────────
# Shared secret for /api/cron/automations. Without it that endpoint refuses to
# run — an unauthenticated endpoint that sends SMS on demand is someone else's
# marketing budget. Generate with: openssl rand -hex 32
CRON_SECRET=""

# Hosting Postgres on Supabase or Neon needs nothing beyond DATABASE_URL and
# DIRECT_URL above — they are ordinary Postgres connection strings. This file used
# to list SUPABASE_* keys, including a service-role key that bypasses row-level
# security; nothing in the application ever read them, and a god-mode credential
# in an environment that has no use for it is a liability rather than an option.
