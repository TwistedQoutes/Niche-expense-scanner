<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar icon.

  Android masks a notification icon to its alpha channel and tints the result,
  so anything with colour in it arrives as a solid white blob. This is the mark
  drawn as a flat silhouette, which is what the system wants.

  Viewport is the mark's own ink box, same as scripts/generate-app-icons.mjs,
  with a little room so nothing touches the edge after the system's own padding.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="22"
    android:viewportHeight="22"
    android:tint="#FFFFFF">

    <group android:translateX="-5.35" android:translateY="-5.325">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M9.25,14.6 m -2.4,0 a 2.4,2.4 0 1,0 4.8,0 a 2.4,2.4 0 1,0 -4.8,0" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M14,17.25 l3.4,3.4 L24.25,12" />
    </group>
</vector>
