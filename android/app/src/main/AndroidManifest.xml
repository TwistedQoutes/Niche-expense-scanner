<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                App Links. A quote or reset link sent by email opens in the app
                when it is installed and in the browser when it is not, with no
                chooser in between. android:autoVerify makes Android check
                /.well-known/assetlinks.json on the domain, so a different app
                cannot claim these URLs.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="jobflowai.dev" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
            Where a notification with no channel of its own lands. Declared so
            that a push arriving before the app has created its channels still
            shows, rather than being dropped silently on Android 8 and later.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <!--
            A flat white silhouette. Android tints the status-bar icon and
            ignores colour, so handing it the full-colour launcher icon produces
            a white square.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Android 13 and later. Without it the system grants no notification
        permission at all and push is silently dead on new phones; the app asks
        for it at runtime (see NativeBridge).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Before-and-after job photographs. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Reading a photo the crew member took earlier. The granular media
        permission on Android 13+, the old storage read below it, which is
        declared only up to API 32 so Play does not ask why a modern app wants
        blanket storage access.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        Ordering the day's driving, and showing the workspace which job someone
        is on. Fine location because a street address is the unit of work here;
        coarse is declared alongside it so a person who grants only approximate
        location still gets a usable route.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        Declared as not required so the app still installs on a tablet with no
        GPS or camera. Both features degrade rather than break.
    -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
